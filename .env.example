# Paste ONLY the cookie VALUE (not the name).
# Cookie name must be: __Secure-next-auth.session-token
PPLX_COOKIE=

# Optional: chrome | chrome131 | etc. (curl_cffi impersonate target)
PPLX_IMPERSONATE=chrome

# Perplexity web API version string sent in ask params
PPLX_API_VERSION=2.18

# Default model_preference for asks (internal Perplexity id).
# This is chosen by YOU / this client per request — the cookie does not return
# a stored "selected model" for ask. Common values:
#   pplx_pro          Perplexity default / Best
#   experimental      Sonar-ish experimental path
#   gpt56_terra       GPT family (ids change over time)
#   claude46sonnet    Claude family (ids change over time)
#   gemini31pro_high  Gemini family (ids change over time)
# Override per call: python cli.py --model claude46sonnet chat "..."
PPLX_MODEL=pplx_pro

# Ask mode sent in params.mode
#   concise  lighter / auto-ish path (also auto-used for pplx_pro/turbo/auto)
#   copilot  Pro Search style path (deeper search; uses Pro Search quota)
# Override per call: python cli.py --mode concise chat "..."
PPLX_MODE=copilot

PPLX_LANGUAGE=en-US
PPLX_INCOGNITO=true
